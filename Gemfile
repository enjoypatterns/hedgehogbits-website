source "https://rubygems.org"

# Matches the Jekyll version and plugins GitHub Pages uses.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
end

gem "webrick", "~> 1.8"

# Standard libraries that newer Rubies no longer bundle (needed for local builds only).
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
